# Install with its timer:
#   sudo cp deploy/resolve-alerts.service deploy/resolve-alerts.timer /etc/systemd/system/
#   sudo systemctl daemon-reload && sudo systemctl enable --now resolve-alerts.timer
# Edit User and paths if not pi / /home/pi/Trading_Alerts.
# Oneshot: the timer starts it, it runs once and exits, and systemd never
# starts a second copy while one is still running. Independent of
# signal-bot: either can fail without the other.
[Unit]
Description=Resolve signal bot alert outcomes
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=pi
WorkingDirectory=/home/pi/Trading_Alerts
EnvironmentFile=/home/pi/Trading_Alerts/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/Trading_Alerts/.venv/bin/python resolve_alerts.py
