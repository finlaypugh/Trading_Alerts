# Install with deploy/install.sh, which fills in User= and the paths
# No Requires=/BindsTo= on signal-bot: either can die without the other.
# No NoNewPrivileges=: the restart/stop/start buttons need sudo.
[Unit]
Description=Signal bot dashboard
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Trading_Alerts
EnvironmentFile=/home/pi/Trading_Alerts/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/Trading_Alerts/.venv/bin/python -m dashboard
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
