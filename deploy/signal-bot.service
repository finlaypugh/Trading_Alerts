# Install with deploy/install.sh, which fills in User= and the paths
# The unit name is what the dashboard's buttons and deploy/sudoers-signal-bot refer to.
[Unit]
Description=Trading signal bot
After=network-online.target
Wants=network-online.target

[Service]
User=pi
WorkingDirectory=/home/pi/Trading_Alerts
EnvironmentFile=/home/pi/Trading_Alerts/.env
Environment=PYTHONUNBUFFERED=1
ExecStart=/home/pi/Trading_Alerts/.venv/bin/python signal_bot.py
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
