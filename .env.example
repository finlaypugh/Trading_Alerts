# Copy this file to .env and fill in your values.
# Required:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/yyyyyyyyyy

# Required. Candles for both the live bot and backtest.py come from OANDA.
# Generate from your OANDA account: Manage API Access -> Generate Personal
# Access Token. Use a free practice account: the candles are the same, and
# OANDA tokens can trade, so keep this one away from real money.
OANDA_API_TOKEN=
OANDA_ENVIRONMENT=practice

# OANDA instrument. Gold: XAU_USD (spot).
SIGNAL_TICKER=XAU_USD
# 1m, 5m, 15m, 30m, 1h, 4h or 1d -- sizes OANDA has candles for. 1m matches
# the source material and backtest.py's default.
SIGNAL_INTERVAL=1m
# History pulled each poll, as a number + m/h/d. 3d still clears the 200-bar
# warm-up on a Monday morning, after the weekend gap, and at 1m fits in one
# OANDA request.
SIGNAL_LOOKBACK=3d

# Trend filter: triple EMA
SIGNAL_EMA_FAST=20
SIGNAL_EMA_MID=50
SIGNAL_EMA_SLOW=100

# Trigger: Williams Fractals
SIGNAL_FRACTAL_N=2
SIGNAL_FRACTAL_MAX_PLATEAU=4

# Pullback episodes. EXPIRY_BARS closes an episode once price has been back
# above the fast EMA for this many bars -- without it, a pullback from hours
# ago still arms an entry. REQUIRE_PULLBACK=false allows no-pullback trend
# continuation entries as WEAK alerts (the source material does not endorse
# these).
SIGNAL_PULLBACK_EXPIRY_BARS=3
SIGNAL_REQUIRE_PULLBACK=true

# Reject a fractal that formed before the pullback began. The video's sequence
# is pullback first, fractal at its low. Turn off only to compare behaviour.
SIGNAL_REQUIRE_PIVOT_IN_PULLBACK=true

# The video's "no trade" state: MAs crossing or disorderly. Requires the stack
# to have held its order for this many consecutive closed bars.
SIGNAL_MIN_STACK_BARS=3

# 2 = mirror the long side. 1 = only the pullback-above-20 short the video
# actually describes.
SIGNAL_SHORT_MAX_DEPTH=2

# Risk
SIGNAL_RR=1.5
SIGNAL_SL_BUFFER_ATR=0.25
# slow: every stop goes beyond the slow EMA, the setup's own invalidation
# line. tiered: the source's rule, a depth-1 pullback stops beyond the mid --
# the worst-performing slice in every backtest, so it is not the default.
SIGNAL_STOP_REF=slow
# Refuse a setup whose risk is under this many bid/ask spreads (OANDA's, on
# the signal bar). Spread is paid once per trade, so a tight stop starts deep
# in the red. 0 = off.
SIGNAL_MIN_RISK_SPREADS=6.0
SIGNAL_ATR_LEN=14
# "The fan is too tight": a separation floor, in ATRs, between the fast and
# slow EMAs. Complements SIGNAL_MIN_STACK_BARS -- that one times the stack,
# this one measures it. Try 0.1-0.2 if alerts still cluster in chop.
SIGNAL_MIN_STACK_SEP_ATR=0.0
# 0 = no ceiling. Set to e.g. 4.0 to reject entries whose stop is absurdly far.
SIGNAL_MAX_RISK_ATR=0.0

# Candle hygiene
SIGNAL_DROP_UNCLOSED_BAR=true
SIGNAL_SESSION_GAP_MULT=2.0

# Alert throttling: minimum bars between same-direction alerts.
SIGNAL_COOLDOWN_BARS=4

SIGNAL_WEAK_STRENGTH_CAP=0.5

# Signals are read off the last closed bar only, so a poll must land inside
# every bar or that bar is never evaluated. 30s = 2 polls per 1m candle.
SIGNAL_POLL_SECONDS=30

# ---- Dashboard (run_dashboard.sh / python -m dashboard) ----
# Required for the quick-command buttons; unset = read-only dashboard.
# Generate one: python -c "import secrets; print(secrets.token_urlsafe(24))"
DASHBOARD_TOKEN=
DASHBOARD_HOST=0.0.0.0
DASHBOARD_PORT=8080
# Bot output for the log panel when the bot is not the signal-bot systemd
# unit, e.g. /home/pi/.pm2/logs/trading-alerts-out.log. Unset = journalctl.
DASHBOARD_LOG_FILE=
# Closed bars the bot keeps in .bars_<ticker>.json for the dashboard chart.
# Read by the bot, not the dashboard. Alert outcomes are resolved against
# these, so older alerts show as unknown. 1500 is about a day of 1m bars.
DASHBOARD_BARS=1500
