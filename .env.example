# Copy this file to .env and fill in your values.
# Required:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/yyyyyyyyyy

# Yahoo Finance symbol. Gold: GC=F (COMEX futures) -- Yahoo has no spot
# XAUUSD feed, so TradingView-style symbols like OANDA:XAUUSD return no data.
SIGNAL_TICKER=GC=F
SIGNAL_INTERVAL=15m
# yfinance caps 15m history at 60 days; 10d clears the 200-bar warm-up easily.
SIGNAL_LOOKBACK=10d

# Trend filter: triple EMA
SIGNAL_EMA_FAST=20
SIGNAL_EMA_MID=50
SIGNAL_EMA_SLOW=100

# Trigger: Williams Fractals
SIGNAL_FRACTAL_N=2
SIGNAL_FRACTAL_MAX_PLATEAU=4

# Pullback episodes. EXPIRY_BARS closes an episode once price has been back
# above the fast EMA for this many bars -- without it, a pullback from hours
# ago still arms an entry. REQUIRE_PULLBACK=false allows no-pullback trend
# continuation entries as WEAK alerts (the source material does not endorse
# these).
SIGNAL_PULLBACK_EXPIRY_BARS=3
SIGNAL_REQUIRE_PULLBACK=true

# Reject a fractal that formed before the pullback began. The video's sequence
# is pullback first, fractal at its low. Turn off only to compare behaviour.
SIGNAL_REQUIRE_PIVOT_IN_PULLBACK=true

# The video's "no trade" state: MAs crossing or disorderly. Requires the stack
# to have held its order for this many consecutive closed bars.
SIGNAL_MIN_STACK_BARS=3

# 2 = mirror the long side. 1 = only the pullback-above-20 short the video
# actually describes.
SIGNAL_SHORT_MAX_DEPTH=2

# Risk
SIGNAL_RR=1.5
SIGNAL_SL_BUFFER_ATR=0.25
SIGNAL_ATR_LEN=14
# "The fan is too tight": a separation floor, in ATRs, between the fast and
# slow EMAs. Complements SIGNAL_MIN_STACK_BARS -- that one times the stack,
# this one measures it. Try 0.1-0.2 if alerts still cluster in chop.
SIGNAL_MIN_STACK_SEP_ATR=0.0
# 0 = no ceiling. Set to e.g. 4.0 to reject entries whose stop is absurdly far.
SIGNAL_MAX_RISK_ATR=0.0

# Candle hygiene
SIGNAL_DROP_UNCLOSED_BAR=true
SIGNAL_SESSION_GAP_MULT=2.0

# Alert throttling: minimum bars between same-direction alerts.
SIGNAL_COOLDOWN_BARS=4

SIGNAL_WEAK_STRENGTH_CAP=0.5

# 300s = 3 polls per 15m candle, which is plenty now that signals only
# evaluate on closed bars.
SIGNAL_POLL_SECONDS=300
