# Example environment variables for Trading_Alerts
# Copy this to `.env` and fill in real values (do NOT commit `.env`)

DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/your_webhook_here
SIGNAL_TICKER=BTC-USD
SIGNAL_INTERVAL=15m
SIGNAL_LOOKBACK=5d

# Strategy params (optional)
SIGNAL_FAST_EMA=9
SIGNAL_SLOW_EMA=21
SIGNAL_RSI_LEN=14

# Polling
SIGNAL_POLL_SECONDS=900
