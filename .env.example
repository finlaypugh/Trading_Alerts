# Copy this file to .env and fill in your values.
# Required:
DISCORD_WEBHOOK_URL=https://discord.com/api/webhooks/xxxxxxxxxx/yyyyyyyyyy

# Optional overrides (defaults shown):
SIGNAL_TICKER=BTC-USD
# 5m is the sane floor for these strategies: the 200-EMA needs 400+ bars of
# warm-up and fractals on 1m candles are extremely noisy.
SIGNAL_INTERVAL=5m
SIGNAL_LOOKBACK=5d

# Strategy A: Williams Fractals
SIGNAL_FRACTAL_N=2
SIGNAL_FRACTAL_MAX_PLATEAU=4

# Strategy B: Triple EMA
SIGNAL_EMA_1=50
SIGNAL_EMA_2=100
SIGNAL_EMA_3=200

SIGNAL_ATR_LEN=14
SIGNAL_SL_ATR_MULT=1.5
SIGNAL_TP_RR_MIN=1.5
SIGNAL_TP_RR_MAX=3.0

SIGNAL_WEAK_STRENGTH_CAP=0.5

SIGNAL_POLL_SECONDS=900
